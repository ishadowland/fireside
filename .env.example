# Fireside environment configuration (example)
# Copy to `.env` and fill in real values for local development.
# `.env` is gitignored; this file is committed as a template.

# === HTTP server ===
# Port for the single-port HTTP + WebSocket listener.
PORT=8080

# === Database ===
# Postgres DSN. Format matches pgx.ParseConfig semantics.
# For local docker-compose: postgres://fireside:fireside@localhost:5432/fireside?sslmode=disable
POSTGRES_DSN=postgres://fireside:fireside@localhost:5432/fireside?sslmode=disable

# === Auth ===
# HS256 secret for signing JWTs. MUST be at least 32 bytes in production.
# For dev, a fixed string is fine; rotate before any external deployment.
JWT_SECRET=change-me-in-production-this-is-a-dev-only-placeholder
# Access token TTL in minutes. ADR-0007.
JWT_ACCESS_TTL_MIN=15

# === Logging ===
# log/slog level: debug | info | warn | error
LOG_LEVEL=info

# === SMS (stub) ===
# Sprint 0 stub accepts any phone + the code below. Sprint 1+ swaps in a real provider.
SMS_STUB_CODE=1234

# === Multi-instance guard (future, ADR-0013) ===
# When the deployment runs >1 instance, these envs activate the Redis-backed
# fallbacks. Currently a no-op — the in-process paths are used.
# REDIS_URL=redis://localhost:6379/0