#!/usr/bin/env bash
#
# Minimal gradlew stub. The real gradle wrapper (gradlew, gradlew.bat,
# gradle/wrapper/gradle-wrapper.jar) is generated by running:
#
#   cd android
#   gradle wrapper --gradle-version 8.9 --distribution-type bin
#
# (requires Gradle 8.x installed locally) OR by copying from a sibling
# Android project that already has a wrapper. Sprint 0 ships this stub so
# the directory layout is complete and CI can later resolve the wrapper
# when run on a machine that has the jar locally.
#
# Replace this file with the generated wrapper before first build.

set -euo pipefail

if [ ! -f "gradle/wrapper/gradle-wrapper.jar" ]; then
    echo "error: gradle-wrapper.jar is missing." >&2
    echo "       Run 'gradle wrapper --gradle-version 8.9 --distribution-type bin' once," >&2
    echo "       then 'git add gradlew gradlew.bat gradle/wrapper/'." >&2
    exit 1
fi

if [ -n "${JAVA_HOME:-}" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA="$(command -v java)"
fi

exec "$JAVA" -classpath "gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain "$@"