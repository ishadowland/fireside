<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Splash/Activity theme only — Compose Material3 supplies the real
      colors via FiresideTheme(). A pure-framework parent avoids pulling
      in the com.google.android.material library (we only use Compose,
      not Material views).
    -->
    <style name="Theme.Fireside" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ember_red</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>