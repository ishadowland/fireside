<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fireside"
        android:usesCleartextTraffic="true">

        <!-- TODO: remove usesCleartextTraffic="true" before any HTTPS deployment.
             Sprint 0 backend is plain HTTP/WS (RFC §"What we are NOT doing").
             Removing this requires ws:// → wss:// in WsClient baseUrl too. -->

        <!-- WP-9.1: launcher. -->
        <activity
            android:name=".RoomListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fireside">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WP-9.2: opened by RoomListActivity with extra "room_id". -->
        <activity
            android:name=".RoomActivity"
            android:exported="false"
            android:label="房间"
            android:theme="@style/Theme.Fireside" />

        <!-- Sprint 0 debug tool: kept for manual WS probing, not exported. -->
        <activity
            android:name=".ConnectActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fireside" />
    </application>

</manifest>